# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env.example)
# ==========================================

# Production Backend API URL
# Leave blank or omit for local development (uses Vite proxy to http://localhost:5000)
# On Vercel: set to your deployed Render service URL (e.g. https://exam-seating-backend.onrender.com)
VITE_API_URL=https://your-backend.onrender.com
