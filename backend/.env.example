# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==========================================

# Server Port (Render sets this dynamically, but default is 5000 for local)
PORT=5000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/exam_seating_system?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/exam_seating_system
MONGO_URI=mongodb://127.0.0.1:27017/exam_seating_system

# JWT Authentication Secret Key
JWT_SECRET=supersecretjwtkey_exam_seating_system_2026

# Environment ('development' for local, 'production' for Render)
NODE_ENV=development

# Frontend Client URL for CORS
# In production on Render, set this to your Vercel URL (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:3000
